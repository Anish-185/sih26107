# Copy to .env.local for local overrides.

# Where the built app should send API calls. In dev the Vite proxy handles
# "/api" -> the FastAPI service, so this is only needed for production builds
# or when not using the dev proxy.
# VITE_API_BASE=http://127.0.0.1:8000

# Backend origin the dev-server proxy forwards "/api" to (defaults to
# http://127.0.0.1:8000).
# VITE_BACKEND_ORIGIN=http://127.0.0.1:8000
