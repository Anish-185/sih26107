# Optional overrides. Every value below has a working default, so the backend
# runs with no .env at all. These are read from the process environment
# (e.g. `export LLM_MODEL=...`) — there is no .env auto-loader.

# --- Database (not used yet) ---
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bis_assistant

# --- Local LLM (LM Studio, OpenAI-compatible) — read by app/llm.py ---
# Defaults shown; only set these to override.
# LLM_BASE_URL=http://127.0.0.1:1234/v1
# LLM_MODEL=qwen/qwen3-4b
